# ADMIN_PASSWORD_HASH uses bcrypt ($2y$12$...).
ADMIN_USERNAME="syedking12"
ADMIN_PASSWORD_HASH="$2y$12$6WVElVwcywwCOswV8L4yeOHTrU072UXds.1Nt79mb46LYfzoIWEca"
